<Window x:Class="Assoziationen_Personen_Hauptwohnsitz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personen und Hauptwohnsitz" Height="400" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Adressen (bitte auswählen):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Bewohner an dieser Adresse:" FontWeight="Bold" Margin="0,0,0,5"/>

        <ListView x:Name="lvAdressen" Grid.Row="1" Grid.Column="0" SelectionChanged="lvAdressen_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Straße" DisplayMemberBinding="{Binding Strasse}" Width="120"/>
                    <GridViewColumn Header="Nr." DisplayMemberBinding="{Binding Hausnummer}" Width="45"/>
                    <GridViewColumn Header="PLZ" DisplayMemberBinding="{Binding PLZ}" Width="55"/>
                    <GridViewColumn Header="Ort" DisplayMemberBinding="{Binding Ort}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ListView x:Name="lvPersonen" Grid.Row="1" Grid.Column="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ID}" Width="35"/>
                    <GridViewColumn Header="Vorname" DisplayMemberBinding="{Binding Vorname}" Width="90"/>
                    <GridViewColumn Header="Nachname" DisplayMemberBinding="{Binding Nachname}" Width="95"/>
                    <GridViewColumn Header="E-Mail" DisplayMemberBinding="{Binding Email}" Width="140"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>